# Committed Docker defaults — loaded automatically by docker-compose.
# Override secrets in backend/.env (optional). PUBLIC_SITE_URL is also set in compose.

DATABASE_URL=sqlite:///./data/jobalert.db
PUBLIC_SITE_URL=https://indiagovjob.online
FETCH_INTERVAL_MINUTES=60
CORS_ORIGINS=https://indiagovjob.online,https://www.indiagovjob.online,http://localhost:3000

# Set real values in backend/.env on the server (optional overrides):
# SECRET_KEY=
# ADMIN_SECRET=
# OPENAI_API_KEY=
# SMTP_* / TWILIO_*
