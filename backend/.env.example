# Copy to backend/.env and fill in values

# Database
DATABASE_URL=sqlite:///./data/jobalert.db

# Public site URL (used for CORS, email/WhatsApp links)
PUBLIC_SITE_URL=https://indiagovjob.online

# Auto-fetch interval (minutes) — runs automatically in background
FETCH_INTERVAL_MINUTES=60

# Docker sets SKIP_INITIAL_FETCH=1 in compose to avoid boot-time scrape OOM on small VPS
# SKIP_INITIAL_FETCH=0

# Security (CHANGE before deploy!)
SECRET_KEY=change-me-run-openssl-rand-hex-32
ADMIN_SECRET=your-admin-password-here
# Comma-separated admin account emails (must register or exist in DB)
ADMIN_EMAILS=admin@example.com

# CORS — PUBLIC_SITE_URL is merged automatically; comma-separated is safest in .env
CORS_ORIGINS=https://indiagovjob.online,https://www.indiagovjob.online,http://localhost:3000

# LLM for PDF parsing & job enrichment (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email alerts (optional — required for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@indiagovjob.online

# WhatsApp alerts (optional — required for WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
