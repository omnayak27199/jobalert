# Copy to backend/.env and fill in values

# Database
DATABASE_URL=sqlite:///./data/jobalert.db

# Auto-fetch interval (minutes) — runs automatically in background
FETCH_INTERVAL_MINUTES=60

# Security (CHANGE before deploy!)
SECRET_KEY=change-me-run-openssl-rand-hex-32
ADMIN_SECRET=your-admin-password-here

# LLM for PDF parsing & job enrichment (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@jobalert.in

# WhatsApp alerts (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# CORS — add your domain after deploy
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
